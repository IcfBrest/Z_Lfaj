# ---- 数据库 ----
# 本机开发可用 sqlite:///./data/app.db；生产 compose 内用 postgresql+psycopg://app:app@db:5432/app
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# ---- 安全（生产必须替换为随机值；.env 不入库）----
# JWT 签名密钥
SECRET_KEY=change-me-to-a-random-secret
# 字段加密主密钥（Fernet）：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-generate-a-fernet-key

# ---- LLM 任务分级默认模型（用户可在 provider 配置中覆盖）----
DEFAULT_PARSE_MODEL=deepseek-chat
DEFAULT_SCORE_MODEL=deepseek-chat
DEFAULT_SUGGEST_MODEL=deepseek-chat

# ---- 应用 ----
APP_HOST=127.0.0.1
APP_PORT=8000
